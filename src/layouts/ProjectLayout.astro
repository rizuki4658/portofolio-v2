---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";

interface Props {
  title: string;
  description: string;
  role: string;
  type: string;
  status: string;
  year: number;
  stack: string[];
  highlights: string[];
  demoUrl?: string;
  sourceUrl?: string;
  screenshots?: {
    title: string;
    src: string;
    alt: string;
    orientation: string;
  }[];
}

const {
  title,
  description,
  role,
  type,
  status,
  year,
  stack,
  highlights,
  demoUrl,
  sourceUrl,
  screenshots = [],
} = Astro.props;

const projectMeta = [
  {
    label: "Role",
    value: role,
  },
  {
    label: "Type",
    value: type,
  },
  {
    label: "Status",
    value: status,
  },
  {
    label: "Year",
    value: year,
  },
];
---

<BaseLayout title={`${title} — Case Study`} description={description} type="article">
  <article>
    <section class="border-b border-slate-200 bg-slate-50 py-20">
      <Container>
        <div class="max-w-5xl">
          <a
            href="/#projects"
            class="text-sm font-medium text-slate-500 transition hover:text-slate-950"
          >
            ← Back to projects
          </a>

          <div class="mt-8 flex flex-wrap gap-2">
            <Badge label={status} />
            <Badge label={type} />
          </div>

          <h1 class="mt-6 max-w-4xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
            {title}
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
            {description}
          </p>

          {(demoUrl || sourceUrl) && (
            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              {demoUrl && (
                <Button
                  href={demoUrl}
                  variant="primary"
                  target="_blank"
                  rel="noreferrer"
                >
                  View Demo
                </Button>
              )}

              {sourceUrl && (
                <Button
                  href={sourceUrl}
                  variant="secondary"
                  target="_blank"
                  rel="noreferrer"
                >
                  View Source
                </Button>
              )}
            </div>
          )}
        </div>
      </Container>
    </section>

    <section class="border-b border-slate-200 bg-white py-12">
      <Container>
        <div class="grid gap-4 md:grid-cols-4">
          {projectMeta.map((item) => (
            <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
              <p class="text-sm font-medium text-slate-500">{item.label}</p>
              <p class="mt-2 text-base font-semibold text-slate-950">
                {item.value}
              </p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section class="border-b border-slate-200 bg-slate-50 py-16">
      <Container>
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
              Highlights
            </p>

            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">
              What this project demonstrates.
            </h2>
          </div>

          <div class="grid gap-4">
            {highlights.map((highlight) => (
              <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-base leading-7 text-slate-700">
                  {highlight}
                </p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    {screenshots.length > 0 && (
      <section class="border-b border-slate-200 bg-white py-16">
        <Container>
          <div class="space-y-10">
            <div class="max-w-2xl">
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
                Visual Preview
              </p>

              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">
                Screenshots from the product experience.
              </h2>

              <p class="mt-4 text-base leading-7 text-slate-600">
                A quick look at the main interface flows and dashboard sections.
              </p>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
              {screenshots.map((screenshot) => (
                <figure class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-sm">
                  <div
                    class:list={[
                      "bg-slate-100",
                      screenshot.orientation === "mobile"
                        ? "flex aspect-[16/10] items-center justify-center p-6"
                        : "aspect-[16/10]",
                    ]}
                  >
                    <img
                      src={screenshot.src}
                      alt={screenshot.alt}
                      loading="lazy"
                      class:list={[
                        screenshot.orientation === "mobile"
                          ? "h-full max-h-[420px] w-auto rounded-2xl object-contain shadow-sm"
                          : "h-full w-full object-cover object-top",
                      ]}
                    />
                  </div>

                  <figcaption class="border-t border-slate-200 bg-white px-5 py-4">
                    <p class="text-sm font-semibold text-slate-950">
                      {screenshot.title}
                    </p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </Container>
      </section>
    )}

    <section class="border-b border-slate-200 bg-white py-16">
      <Container>
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
            Tech Stack
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            {stack.map((item) => (
              <Badge label={item} />
            ))}
          </div>
        </div>
      </Container>
    </section>

    <section class="bg-white py-20">
      <Container>
        <div class="prose prose-slate max-w-3xl prose-headings:tracking-tight prose-headings:text-slate-950 prose-p:leading-8 prose-li:leading-8">
          <slot />
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>
