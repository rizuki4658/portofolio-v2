---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
---

<BaseLayout>
  <section class="border-b border-slate-200 bg-slate-50">
    <Container>
      <div class="flex min-h-[calc(100vh-4rem)] flex-col justify-center py-20">
        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
            Portfolio Website
          </p>

          <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
            AI-powered Frontend Engineer building clean, scalable, and production-ready web interfaces.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
            I build frontend applications with a strong focus on clean architecture,
            product thinking, user experience, and maintainable code.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="#projects"
              class="inline-flex items-center justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-medium text-white transition hover:bg-slate-800"
            >
              View Projects
            </a>

            <a
              href="#contact"
              class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-medium text-slate-950 shadow-sm transition hover:bg-slate-100"
            >
              Contact Me
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section id="projects" class="border-b border-slate-200 bg-white py-20">
    <Container>
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
          Featured Project
        </p>

        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">
          AI Content Workspace
        </h2>

        <p class="mt-4 text-base leading-7 text-slate-600">
          A modern SaaS-style dashboard for generating, managing, and analyzing
          AI-powered content. Built with Next.js, TypeScript, shadcn/ui, Recharts,
          IndexedDB, and a fake API layer.
        </p>
      </div>
    </Container>
  </section>

  <section id="skills" class="border-b border-slate-200 bg-slate-50 py-20">
    <Container>
      <h2 class="text-3xl font-semibold tracking-tight text-slate-950">
        Skills
      </h2>

      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600">
        Vue.js, React, Next.js, Astro, TypeScript, Tailwind CSS, dashboard UI,
        responsive design, and AI-assisted development.
      </p>
    </Container>
  </section>

  <section id="experience" class="border-b border-slate-200 bg-white py-20">
    <Container>
      <h2 class="text-3xl font-semibold tracking-tight text-slate-950">
        Experience
      </h2>

      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600">
        Frontend Developer with experience building SaaS dashboards, ecommerce
        systems, and production-ready interfaces.
      </p>
    </Container>
  </section>

  <section id="contact" class="bg-slate-950 py-20 text-white">
    <Container>
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight">
          Let’s build something clean, fast, and scalable.
        </h2>

        <p class="mt-4 text-base leading-7 text-slate-300">
          Open to frontend engineering opportunities, SaaS product work, and
          selected freelance projects.
        </p>

        <a
          href="mailto:rizkikhair4658@gmail.com"
          class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-medium text-slate-950 transition hover:bg-slate-200"
        >
          Contact Me
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
