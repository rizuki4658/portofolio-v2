---
import Container from "./Container.astro";
import Button from "../ui/Button.astro";

const navItems = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-slate-50/80 backdrop-blur">
  <Container>
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="text-sm font-semibold tracking-tight text-slate-950">
        Rizki Khair
      </a>

      <nav class="hidden items-center gap-6 md:flex">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-slate-600 transition hover:text-slate-950"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <Button href="#contact" variant="secondary" size="sm" class="hidden md:inline-flex">
        Let’s Talk
      </Button>
    </div>
  </Container>
</header>
