---
type Variant =
  | "default"
  | "primary"
  | "success"
  | "warning"
  | "info"
  | "purple"
  | "dark";

interface Props {
  label: string;
  variant?: Variant;
}

const { label, variant = "default" } = Astro.props;

const variants: Record<Variant, string> = {
  default: "border-slate-200 bg-slate-50 text-slate-700",
  primary: "border-slate-300 bg-slate-950 text-white",
  success: "border-emerald-200 bg-emerald-50 text-emerald-700",
  warning: "border-amber-200 bg-amber-50 text-amber-700",
  info: "border-blue-200 bg-blue-50 text-blue-700",
  purple: "border-violet-200 bg-violet-50 text-violet-700",
  dark: "border-slate-700 bg-slate-900 text-slate-100",
};

const classes = `inline-flex rounded-full border px-3 py-1 text-sm font-medium ${variants[variant]}`;
---

<span class={classes}>
  {label}
</span>
