---
import Badge from "./Badge.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  tags: string[];
  label?: string;
  status?: string;
  year?: number;
  highlights?: string[];
}

const {
  title,
  description,
  href,
  tags,
  label = "Project",
  status,
  year,
  highlights = [],
} = Astro.props;

const previewHighlights = highlights.slice(0, 2);
const previewTags = tags.slice(0, 4);
---

<a
  href={href}
  class="group flex w-[82vw] shrink-0 flex-col rounded-3xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-md md:w-[calc(50vw-3.25rem)] lg:w-[calc((72rem-2rem)/2)]"
>
  <div class="flex flex-1 flex-col">
    <div class="flex flex-wrap items-center gap-2">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
        {label}
      </p>

      {status && (
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
          {status}
        </span>
      )}

      {year && (
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
          {year}
        </span>
      )}
    </div>

    <h3 class="mt-3 text-xl font-semibold tracking-tight text-slate-950">
      {title}
    </h3>

    <p class="mt-3 text-sm leading-6 text-slate-600">
      {description}
    </p>

    {previewHighlights.length > 0 && (
      <ul class="mt-5 hidden space-y-2 sm:block">
        {previewHighlights.map((highlight) => (
          <li class="flex gap-2.5 text-sm leading-6 text-slate-600">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-950"></span>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-6 flex flex-wrap gap-2">
      {previewTags.map((tag) => (
        <Badge label={tag} />
      ))}

      {tags.length > previewTags.length && (
        <span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-slate-500">
          +{tags.length - previewTags.length}
        </span>
      )}
    </div>

    <div class="mt-auto pt-6 text-sm font-medium text-slate-500 transition group-hover:text-slate-950">
      Read More →
    </div>
  </div>
</a>
