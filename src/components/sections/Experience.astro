---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const highlights = [
  "Building SaaS dashboard interfaces and admin tools",
  "Working with ecommerce and trade-in product flows",
  "Structuring reusable frontend components",
  "Improving UI maintainability and user experience",
];
---

<section id="experience" class="border-b border-slate-200 bg-slate-50 py-20">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <SectionTitle
        eyebrow="Experience"
        title="Frontend development for real product workflows."
        description="Experience building production-ready interfaces across SaaS, ecommerce, and dashboard-heavy applications."
      />

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-semibold tracking-tight text-slate-950">
          Frontend Developer
        </h3>

        <p class="mt-3 text-base leading-7 text-slate-600">
          I have experience building frontend applications that involve complex
          workflows, responsive layouts, state handling, and production UI details.
        </p>

        <ul class="mt-6 space-y-3">
          {highlights.map((item) => (
            <li class="flex gap-3 text-base leading-7 text-slate-600">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-slate-950"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>
