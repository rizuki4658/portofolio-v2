---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";

const links = [
  {
    label: "Email",
    href: "mailto:rizkikhair4658@gmail.com",
  },
  {
    label: "GitHub",
    href: "https://github.com/rizuki4658",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/rizki-khair-0b5a67186/",
  },
  {
    label: "Upwork",
    href: "https://www.upwork.com/freelancers/~01d508c0a118e53e90?mp_source=share",
  },
];
---

<section id="contact" class="bg-slate-950 py-20 text-white">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">
          Contact
        </p>

        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Let’s build something clean, fast, and scalable.
        </h2>

        <p class="mt-4 text-base leading-7 text-slate-300">
          Open to frontend engineering opportunities, SaaS product work, and
          selected freelance projects.
        </p>

        <Button href="mailto:rizkikhair4658@gmail.com" variant="dark" class="mt-8">
          Contact Me
        </Button>
      </div>

      <div class="flex flex-wrap gap-3 lg:justify-end">
        {links.map((link) => (
          <Button
            href={link.href}
            variant="outline"
            size="sm"
            target="_blank"
            rel="noreferrer">
            {link.label}
          </Button>
        ))}
      </div>
    </div>
  </Container>
</section>
