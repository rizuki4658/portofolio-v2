---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";

const links = [
  {
    label: "GitHub",
    href: "#",
  },
  {
    label: "LinkedIn",
    href: "#",
  },
  {
    label: "Upwork",
    href: "#",
  },
];

const availability = [
  "Frontend engineering opportunities",
  "SaaS dashboard and product UI work",
  "Selected freelance projects",
];
---

<section id="contact" class="bg-slate-950 py-20 text-white">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">
          Contact
        </p>

        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Let's build something clean, fast, and scalable.
        </h2>

        <p class="mt-4 text-base leading-7 text-slate-300">
          Open to frontend engineering opportunities, SaaS product work, and selected
          freelance projects where clean UI, maintainable code, and product thinking matter.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="mailto:rizkikhair4658@gmail.com" variant="dark">
            Send Email
          </Button>

          <Button href="#projects" variant="outline">
            View Projects
          </Button>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">
          Available For
        </p>

        <div class="mt-5 space-y-3">
          {availability.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3">
              <p class="text-sm font-medium text-slate-200">
                {item}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          {links.map((link) => (
            <Button href={link.href} variant="outline" size="sm">
              {link.label}
            </Button>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
